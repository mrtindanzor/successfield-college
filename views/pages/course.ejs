<% if(locals.section === 'show'){ %>
  <main-section class="show" data-section="show">
    <div class="content-wrapper">
      <div class="alt-navbar">
        <h3 class="topic"> <%= findCourse.course.toUpperCase() %></h3>
      </div>
    
      <div class="sectors hide">
        <p class="course-overviews">
          <%= findCourse.overview %>
        </p>
      </div>
    
      <% const outlines = findCourse.outlines %>
      <div class="sectors hide">
        <% if(outlines){ %>
          <p class="course-highlights">
            <h3>PROGRAMME OUTLINES</h3>
            <ul class="course-high-list">
              <% outlines.forEach(item => { %>
                <li><%= item.outline %> </li>
              <% }) %>
            </ul>
          </p>
        <% } %>
      </div>
     
      <% const objectives = findCourse.objectives %>
      <div class="sectors hide">
        <% if(objectives){ %>
          <p class="project-topics">
            <h3>PROGRAMME OBJECTIVES:</h3>
            <ol>
              <% objectives.forEach(item => { %>
                <li><%= item.objective %> </li>
              <% }) %>
            </ol>
          </p>
        <% } %>

        <div class="timeline">
          <% const duration = findCourse.duration %>
          <% if(duration){ %>
            <b>Duration: </b>
            <span> <%= duration %> </span>
          <% } %>

          <br>

          <% const availability = findCourse.availability %>
          <% if(availability){ %>
            <b>Availability: </b>
            <span> <%= availability %> </span>
          <% } %>
        </div>
      </div>
      
      <% const benefits = findCourse.benefits %>
      <% if(benefits){ %>
        <div class="sectors hide">
          <p>
          <h3>Benefits of <%= findCourse.course.toLocaleUpperCase() %></h3>
          <ul>
            <% benefits.forEach(item => { %>
              <li> <%= item.benefit %> </li>
            <% }) %> 
          </ul>
        </p>
        </div>
      <% } %>
    
      <% const certificate = findCourse.certificate %>
      <div class="sectors hide">
        <% if(certificate){ %>
          <p>
            <h3>Certificate: </h3>
            <span class="certificate"> <%= certificate %> </span>
          </p>
        <% } %>
      
        <% const fee = findCourse.fee %>
        <% if(fee){ %>
          <p>
            <h3>Fee: </h3>
            <span> <%= fee %> </span>
          </p>
        <% } %>
        <div class="next-tab">
          <a href="/purchase/<%= findCourse.course %>" class="button pd-10 br-radius-4 clr-white proceed-btn">Start Course</a>
        </div>
      </div>
      
      <div class="contrs">
        <button class="back-btn hide-btn">back</button>
        <button class="next-btn hide-btn">next</button>
      </div>
    </div>
  </main-section>
<% } %>

<% if(locals.section === 'add'){ %>
  <main-section class="add">
    <div class="main-wrapper"  data-section="add">
      <div class="forms-wrapper">
      <form class="form active" data-id="course">
        <span class="form-title">
          Enter programme name
        </span>
        <input type="text" required>
        <input type="submit" value="Next">
      </form>
      <form class="form" data-id="course-code">
        <span class="form-title">
          Enter programme code
        </span>
        <input type="text" required>
        <span class="back-button">back</span>
       <input type="submit" value="Next">
      </form>
      <form class="form" data-id="overview">
         <span class="form-title">
           Enter programme overview
         </span>
        <input type="text" required>
       <span class="back-button">back</span>
        <input type="submit" value="Next">
      </form>
      <form class="form" data-id="objectives">
         <span class="form-title">
           Enter course objectives
         </span>
        <input type="text" required>
        <span class="add-more">Add more</span>
         <span class="back-button">back</span>
        <input type="submit" value="Next">
      </form>
      <form class="form" data-id="outlines">
         <span class="form-title">
           Enter course outline
         </span>
        <input type="text" required>
        <span class="add-more">Add more</span>
         <span class="back-button">back</span>
        <input type="submit" value="Next">
        
      </form>
      <form class="form" data-id="benefits">
         <span class="form-title">
           Enter course benefits
         </span>
        <input type="text" required>
        <span class="add-more">Add more</span>
         <span class="back-button">back</span>
        <input type="submit" value="Next">
      </form>
       <form class="form"  data-id="availability">
         <span class="form-title">
           Enter availability
         </span>
        <input type="text" required >
         <span class="back-button">back</span>
        <input type="submit" value="Next">
      </form>
       <form class="form"  data-id="duration">
         <span class="form-title">
           Enter duration
         </span>
        <input type="text" required >
         <span class="back-button">back</span>
        <input type="submit" value="Next">
      </form>
       <form class="form"  data-id="certificate">
         <span class="form-title">
           Enter certification
         </span>
        <input type="text" required >
         <span class="back-button">back</span>
        <input type="submit" value="Next">
      </form>
       <form class="form" data-id="fee">
         <span class="form-title">
           Enter programme fees
         </span>
        <input type="text">
        <span class="back-button">back</span>
        <input type="submit" class="add-course" value="Add course" required>
      </form>
      </div>
    </div>
  </main-section>
<% } %>

