<% const pencil = (new icons('profile-editor-icon', 'Edit profile picture')).pencilFill() %>
<% const profileIcon = (new icons('profile-photo-icon', name)).userLine() %>
<% const closeIcon = (new icons('close-photo-icon', 'Exit')).close() %>
<% const eyeCloseIcon = (new locals.icons('form-eye-close', 'Hide password')).eyeClose() %>
<% const eyeOpenIcon = (new locals.icons('form-eye-open state-active', 'Show password')).eyeOpen() %>
<% const profileImage = user.image %>
<div class="profile-wrapper">
  <div class="main-page">
    <div class="profile-image-tab">
      <div class="photo-tab">
        <% if(profileImage){ %>
          <img src="<%= profileImage.url %>" alt="profile picture" class="profile-img">
        <% }else{ %>
          <%- profileIcon %>
        <% } %>
        <div class="view-profile-image">
          <%- closeIcon %>
          <img src="<%= profileImage ? profileImage.url : '' %>" alt="profile picture" loading="lazy" class="viewer-profile-img">
        </div>
        <label class="photo-chooser">
          <%- pencil %>
          <input type="file" name="image" id="profile-photo-editor" accept=".jpg, .jpeg, .png">
        </label>
      </div>
      <span class="username"><%= name %></span>
      <span class="student-number">Student ID: <%= user.studentNumber.toUpperCase()%></span>
    </div>
    <div class="title-bar">
      <div class="back-button"></div>
      <span class="title">Account information</span>
    </div>
    <ul class="main-links">
      <li >
      <span class="li-heading">Account information</span>
      <ul class="default-active">
        <div class="wrapper">
          <li>
            <span>Name</span>
            <div class="account-item">
              <form class="form-container">
                <% if(!user.namechanged){ %>
                  <span>Update name</span>
                  <i>Name can only be edited once</i>
                <% } %>
                <label>
                  Firstname: 
                  <input type="text" name="firstname" placeholder="Firstname" value="<%= user.firstname %>" <% if(user.namechanged){ %> disabled <% } %>>
                </label>
                <label>
                  Middle name:
                  <input type="text" name="middlename" placeholder="Middle name" <% if(user.middlename){ %> value="<%= user.middlename %>" <% } %> <% if(user.namechanged){ %> disabled <% } %>>
                </label>
                <label>
                  Surname:
                  <input type="text" name="surname" placeholder="surname" value="<%= user.surname %>" <% if(user.namechanged){ %> disabled <% } %>>
                </label>
                <% if(!user.namechanged){ %>
                  <button>Edit name</button>
                <% } %>
              </form>
            </div>
          </li>
          <li>
            <span>Phone number</span>
            <div class="account-item">
              <form class="form-container">
                <span>Change phone number</span>
                <label>
                  Phone number:
                  <input type="tel" name="phone" placeholder="0200000000" <% if(user.phone){ %> value="<%= user.phone%>" <% } %> >
                </label>
                <button>Update</button>
              </form>
            </div>
          </li>
          <li>
            <span>Email</span>
            <div class="account-item">
              <form class="form-container">
                <span>Change email address</span>
                <label>
                  Email:
                  <input type="email" name="email" placeholder="info@example.com" value="<%= user.email%>">
                </label>
                <button>Update</button>
              </form>
            </div>
          </li>
          <li>
            <span>Account Region</span>
            <div class="account-item">
              <form class="form-container">
                <span>Address</span>
                <label>
                  Country:
                  <input type="text" name="country" value="<%= user.address?.country ?? '' %>">
                </label>
                <label>
                  State / Region:
                  <input type="text" name="state" value="<%= user.address?.state ?? '' %>">
                </label>
                <label>
                  City:
                  <input type="text" name="city" value="<%= user.address?.city ?? '' %>">
                </label>
                <label>
                  Address Line 1:
                  <input type="text" name="address1" value="<%= user.address?.address1 ?? '' %>">
                </label>
                <label>
                  Address Line 2:
                  <input type="text" name="address2" value="<%= user.address?.address2 ?? '' %>">
                </label>
                <label>
                  Postal code:
                  <input type="text" name="postalCode" value="<%= user.address?.postalCode ?? '' %>">
                </label>
                <button>Update</button>
              </form>
            </div>
          </li>
          <li>
            <span>Change password</span>
            <div class="account-item">
              <form class="form-container">
                <span>Change password</span>
                <label>
                  Old password:
                  <input type="password" name="oldpassword" placeholder="Enter old password" >
                  <%- eyeOpenIcon %>
                  <%- eyeCloseIcon %>
                </label>
                <label>
                  New password:
                  <input type="password" name="password" placeholder="Enter new password" >
                  <%- eyeOpenIcon %>
                  <%- eyeCloseIcon %>
                </label>
                <label>
                  Confirm new password:
                  <input type="password" name="cpassword" placeholder="Confirm new password" >
                  <%- eyeOpenIcon %>
                  <%- eyeCloseIcon %>
                </label>
                <button>update</button>
              </form>
            </div>
          </li>
          <li>
            <span>Reset password</span>
            <div class="account-item">
              <form class="form-container">
                <span>Reset password</span>
                <label>
                  Email:
                  <input type="email" name="email" placeholder="info@example.com" value="<%= user.email%>">
                </label>
                <button>Send email</button>
              </form>
            </div>
          </li>

        </div>
      </ul>
      </li>
      <li>
      <span class="li-heading">My Courses</span>
      <ul>
        <% const myCourses = locals.user?.courses %>
        <% if(!locals.user?.admin && myCourses?.length > 0){ %> 
          <% for(const myCourse of myCourses){ %>
            <li class="dp-f gap-10">
              <a href="/courses/<%= myCourse.course %>/<%= (myCourse.module || 1) %>"><%= upperCase(myCourse.course) %></a>
            </li>
          <% } %>
        <% } %>
        <% if(locals.user?.admin && courses.length > 0){ %> 
          <% for(const myCourse of courses){ %>
            <li class="dp-f gap-10">
              <a href="/courses/<%= myCourse.course %>/<%= (myCourse.module || 1) %>"><%= upperCase(myCourse.course) %></a>
            </li>
          <% } %>
        <% } %>
      </ul>
      </li>
      <li>
      <span class="li-heading">My Certificates</span>
      <ul>
        <% if(myCertificates?.length > 0){ %> 
          <% for(const myCertificate of myCertificates){ %>
            <li class="bg-white br-2px br-primary dp-f fl-dr-c fl-j-center w-fc pd-20 br-radius-4 gap-10">
              <div class="my-certificate-code clr-primary">Certificate Code: <%= myCertificate.certificateCode?.toUpperCase() %></div>
              <div class="my-certificate-pleted clr-black">Date of completion: <%= upperCase(myCertificate.dateCompleted) %></div>
              <div class="my-certificate-programme clr-black">Programme: <%= upperCase(myCertificate.programme) %></div>
            </li>
          <% } %>
        <% } %>
      </ul>
      </li>
      <li>
      <span class="li-heading">My Learning Progress</span>
      <ul>
        <% if(!locals.user?.admin && myCourses?.length > 0){ %> 
          <% for(const myCourse of myCourses){ %>
            <% const findCourse = courses?.find(el => el.course === myCourse.course) %>
             <% if(!findCourse) continue %>
            <li class="dp-f fl-dr-c gap-10 br-1px br-primary br-radius-4 pd-10 bg-white">
              <div class="my-current-module clr-primary ff-pb"><%= upperCase(myCourse.course) %></div>
              <div class="my-current-module clr-secondary">Module <%= myCourse.module || 1 %></div>
              <a href="/courses/<%= myCourse.course %>/<%= (myCourse.module || 1) %>" class="clr-primary"><%= myCourse.moduleName || findCourse.modules[0].title %></a>
            </li>
          <% } %>
        <% } %>
      </ul>
      </li>
      <li>
      <span class="li-heading">Transactions</span>
      <ul>
      <li><a href="">Payment History</a></li>
      </ul>
      </li>
      <li>
      <span class="li-heading">Support</span>
      <ul>
      <li><a href="">Help center</a></li>
      </ul>
      </li>
      <li>
      <span class="li-heading">Login</span>
      <ul>
      <li><a href="/users/members?switch=true">Switch account</a></li>
      <li><a href="/users/logout">Logout</a></li>
      </ul>
      </li>
    </ul>
  </div>
</div>