<% if(locals.section === 'add'){ %>
  <main-section class="add">
    <div class="main-wrapper" data-section="add">
      <form class="cert-add-form form-basic">
        <h1 class="hts bg-white pd-10">
          Add Certificate
        </h1>
        <label for="studentNumber">
          <b>Student number:</b>
          <input type="text" name="studentNumber" id="studentNumber">
        </label>
        <label for="programme">
          <b>Programme:</b>
          <input type="text" name="programme" id="programme">
        </label>
        <label for="programme">
          <b>Programme code:</b>
          <input type="text" name="courseCode" id="courseCode">
        </label>
        <label for="dateCompleted">
          <b>Date of Completion:</b>
          <input type="text" name="dateCompleted" id="dateCompleted">
        </label>
        <button class="bg-white clr-primary">Add</button>
      </form>
    </div>
  </main-section>
<% } %>

<% if(locals.section === 'edit'){ %>
  <main-section class="edit">
    <div class="main-wrapper"  data-section="edit">
    
      <form class="find-certificate">
        <label for="find-certificate-code">
        <span>
          Search for Certificate ID
        </span>
          <input type="text" class="find-certificate-code" id="find-certificate-code">
        </label>
        
        <input type="submit" value="Find" class="find-certificate-code">
      </form>

      <div class="update-result"></div>
    </div>
  </main-section>
<% } %>

<% if(locals.section === 'delete'){ %>
  <main-section class="delete">
    <div class="delete-cert-wrapper"  data-section="delete">
      <form class="find-cert">
        <input type="text" class="cert">
        <button>find</button>
      </form>
      <div class="find-result"></div>
    </div>
  </main-section>
<% } %>

