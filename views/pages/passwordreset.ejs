<% if(section === 'request-password'){ %>
  <main-section class="request-password" data-section="request-password">
    <div class="forgot-password-page-container">
      <form class="email-container">
        <span class="title">Reset Password</span>
        <input type="text" class="email" placeholder="Enter email address">
        <button class="send-button">Send email</button>
      </form>
    </div>
  </main-section>
<% } %>

<% if(section === 'set-password'){ %>
  <main-section class="set-password" data-section="set-password">
    <% const eyeCloseIcon = (new locals.icons('form-eye-close', 'Hide password')).eyeClose() %>
    <% const eyeOpenIcon = (new locals.icons('form-eye-open state-active', 'Show password')).eyeOpen() %>
    <div class="forgot-password-page-container">
      <div class="wrapper">
        <span class="info">
        </span>
        <form class="email-container">
          <input type="hidden" name="email" value="<%= email %>">
          <label>
            Enter new password
            <input type="password" class="password" name="password" minlength="8" required>
          <%- eyeOpenIcon %>
          <%- eyeCloseIcon %>
          </label>
          <label>
            Confirm new password
            <input type="password" class="password" name="cpassword" minlength="8" required>
            <%- eyeOpenIcon %>
            <%- eyeCloseIcon %>
          </label>
          <button class="send-button">change password</button>
        </form>  
      </div>
    </div>
  </main-section>
<% } %>
