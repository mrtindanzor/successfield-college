<div class="contact-page-wrapper">
  <div class="social-media">
    <h3>
     Contact us on 
    </h3>
    <p>
      <a class="whatsapp-link1" href="https://wa.me/+233591413517" target="_blank"> 
        <%- (new locals.icons('whatsapp-icon', 'Whatsapp page')).whatsapp() %>
        Whatsapp
      </a>
      <a class="twitter-link" href="https://twitter.com/succcollege" target="_blank"> 
        <%- (new locals.icons('twitter-icon', 'Twitter page')).twitter() %>
      </a>
    </p>
  </div>
  <br>
  <span>
    OR
  </span>
  <br>
  <form class="email-form">
    <h3>
      Send us a message  
    </h3>
    <label for="name">
      <span>
        Name:
      </span>
      <input type="text" name="name" id="name" minlength="4" required>
    </label>
    <label for="email">
      <span>
        Email:
      </span>
      <input type="email" name="email" id="email"  required>
    </label>
    <label for="phone">
      <span>
        Phone: 
      </span>
      <input type="tel" name="phone" id="phone" minlength="9" maxlength="13" required>
    </label>
    <label for="subject">
      <span>
        Subject: 
      </span>
      <input type="text" name="subject" id="subject" minlength="4" required>
    </label>
    <label for="message">
      <span>
        Message:
      </span>
      <textarea name="text" id="message" minlength="10" required></textarea>
    </label>
    <button>
      Send
    </button>
  </form>
</div>
<pre class="result">
</pre>