<% if(locals.findModule){ %>
  <% const link = findModule.link %>
  <h1 class="title">
    <%= locals.findModule.title %>
  </h1>

  <div class="module-content">
    <iframe width="100%" height="100%" src="https://www.youtube-nocookie.com/embed/<%= link %>" title="YouTube video player" frameborder="0" allow="accelerometer; encrypted-media; gyroscope;" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
  </div>

  <div class="module-nav-bar">
    <a href="/courses/<%= locals.findCourse.course %>/<%= locals.lastModule %>" class="module-back button">back</a>
    <% if(locals.nextModule) { %>
      <a href="/courses/<%= locals.findCourse.course %>/<%= locals.nextModule %>" class="module-next button">next</a>
    <% } %>
  </div>
<% } %>
