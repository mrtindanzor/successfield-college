<nav>
  <div class="logo-container">
    <img src="/images/logo.png" class="logo">
    <span class="logo-text">
      SUCCESSFIELD COLLEGE
    </span>
  </div>
  <% if(locals.page != "login" && locals.page != "join"){ %>
    <div class="auth-contrs">
        <% if(isLoggedIn){ %>
          <a href="/users/profile" class="auth-logout">
            <%- (new icons('user-line-icon', 'My profile')).userLine()%>
          </a>
        <%} else { %>
          <a href="/users/login" class="auth-login">Login</a>
          <a href="/users/join" class="auth-signup">Signup</a>
        <% } %>
      </div>
  <% } %>
</nav>
<% if(locals.page != "login" && locals.page != "join" && locals.page != 'verifyemail' && locals.page != 'forgotpassword' && locals.page != 'setforgotpassword'){ %>
<header>
  <div class="main-menu">
  <span class="menu-button">
    <%- (new locals.icons('menu-button-icon', 'Menu')).menu() %>
  </span>
  <ul class="menu-list">
    <% if(locals.isAdmin){ %>
      <li class="menu-item"><a href="/admin">Admin Panel</a></li>
    <% } %>
    <li class="menu-item"><a href="/">Home</a></li>
    <% if(locals.courses.length > 0){ %>
      <li>
        <span class="course-list-button" title="Show courses">Courses</span>
        <ul class="course-list-menu">
            <% for(course of courses){ %>
              <li class="course-item"><a href="/courses/<%= course.course %>"><%= course.course %></a></li>
            <% } %>
        </ul>
      </li>
    <% } %>
    <li class="menu-item"><a href="/verify">Verify Certificate</a></li>
    <li class="menu-item"><a href="/members">Accreditation</a></li>
    <!-- <li class="menu-item"><a href="/gallery">Gallery</a></li> -->
    <% if(locals.partner){ %>
      <li class="menu-item"><a href="/partners">Training Partners</a></li>
    <% } %>
    
    <li class="menu-item"><a href="/about">About us</a></li>
    <li class="menu-item"><a href="/contact">Contact us</a></li>
  </ul>
</div>
</header>
<% } %>