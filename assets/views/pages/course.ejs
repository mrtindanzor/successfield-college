<div class="content-wrapper">
  <div class="alt-navbar">
    <button class="alt-navbar-back-btn" onclick="history.back()">Back</button>
    <h3 class="topic"><%- findCourse.course %></h3>
    <button class="alt-navbar-next-btn">Next</button>
  </div>

  <% const overviewItems = findCourse.courseOverviewList %>
    <p class="course-overview">
      <%- findCourse.overview %>
  <% if(overviewItems){ %>
        <ul class="course-overview-list">
          <% let i = 1%>
          <% for(let item of overviewItems){ %>
            <li><%- item[i]%></li>
            <br/>
          <% i++ } %>
        </ul>
  <% } %>
    </p>

  <br/>

  <% const courseHighlight = findCourse.courseHighlight %>
  <% if(courseHighlight){ %>
    <p class="course-highlights">
      <ul class="course-high-list">
        <h3>Program Highlights</h3>

        <% let j = 1%>
        <% for(let item of courseHighlight){ %>
          <li><%- item[j]%></li>
          <br/>
        <% j++ } %>
      </ul>
    </p>
  <% } %>

  <% const semester = findCourse.semester %>
  <% if(semester){ %>
    <p class="course-content">
      <h4>Course Content:</h4>

      <% let k = 1%>
      <% for(let item of semester){ %>
        <b><%- item.year%></b>
        <ol class="course-semister-topics">
          <% let topics = item.content %>
          <% let seminar = item.seminar %>
          <% let workshop = item.workshop %>
          <% for(let topic of topics) { %>
            <li><%= topic.topic %> </li>
            <br/>
          <% } %>
          <% if(seminar){ %>
          <b>Seminar: </b> <%- item.seminar.topic %>
          <br>
          <% }  %>
          <% if(workshop){ %>
          <b>Workshop: </b> <%- item.workshop.topic %> 
      <br/>
          <% }  %>
        </ol>
      <% k++ } %>
    </p>
      <br/>
  <% } %>

  <% const projectTopics = findCourse.projectTopics.topics %>
  <% if(projectTopics){ %>
  <p class="project-topics">
    <h4>Project Topics:</h4>
    Choose one topic and write on
  <ol>
      <% let l = 1%>
      <% for(let item of projectTopics){ %>
        <li><%- item[l]%></li>
        <br/>
      <% l++ } %>
  </ol>
  <br>
  
  <b>Duration:</b> Self-paced, complete at your own speed
  <br>
  
  <b>Availability:</b> Open to anyone, no prerequisites or restrictions
  
  
  <h4>Outcomes:</h4>
  
  <ul>

    <% const outcome = findCourse.outcome %>
    <% if(outcome){ %>
        <% let m = 1%>
        <% for(let item of outcome){ %>
          <li><%- item[m]%></li>
          <br/>
        <% m++ } %>
    <% } %>
      
  </ul>
  </p>
  <% } %>
</div>