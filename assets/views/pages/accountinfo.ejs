<% if(section === 'username'){ %>
  <main-section class="username" data-section="username">
    <div class="page-wrapper">
      <div class="result">
      </div>
      <form class="form-container">
        <span>Change username</span>
        <label>
          Firstname: 
          <input type="text" name="firstname" placeholder="Firstname" value="<%= user.firstname %>" >
        </label>
        <label>
          Middle name:
          <input type="text" name="middlename" placeholder="Middle name" <% if(user.middlename){ %> value="<%= user.middlename %>" <% } %> >
        </label>
        <label>
          Surname:
          <input type="text" name="surname" placeholder="surname" value="<%= user.surname %>" >
        </label>
        <button>Edit name</button>
      </form>
    </div>
  </main-section>
<% } %>

<% if(section === 'phone'){ %>
  <main-section class="phone" data-section="phone">
    <div class="page-wrapper">
      <div class="result">
      </div>
      <form class="form-container">
        <span>Update phone number</span>
        <label>
          Phone number:
          <input type="tel" name="phone" placeholder="0200000000" <% if(user.phone){ %> value="<%= user.phone%>" <% } %> >
        </label>
        <button>Change phone number</button>
      </form>
    </div>
  </main-section>
<% } %>

<% if(section === 'email'){ %>
  <main-section class="email" data-section="email">
    <div class="page-wrapper">
      <div class="result">
      </div>
      <form class="form-container">
        <span>Update email</span>
        <label>
          Email:
          <input type="email" name="email" placeholder="info@example.com" value="<%= user.email%>">
        </label>
        <button>Change email address</button>
      </form>
    </div>
  </main-section>
<% } %>

<% if(section === 'region'){ %>
  <main-section class="region" data-section="region">

  </main-section>
<% } %>

<% if(section === 'password'){ %>
  <% const eyeCloseIcon = (new locals.icons('form-eye-close', 'Hide password')).eyeClose() %>
  <% const eyeOpenIcon = (new locals.icons('form-eye-open state-active', 'Show password')).eyeOpen() %>
  <main-section class="password" data-section="changepassword">
    <div class="page-wrapper">
      <div class="result">
      </div>

      <form class="form-container">
        <span>Change password</span>
        <label>
          Old password:
          <input type="password" name="oldpassword" placeholder="Enter old password" >
          <%- eyeOpenIcon %>
          <%- eyeCloseIcon %>
        </label>
        <label>
          New password:
          <input type="password" name="password" placeholder="Enter new password" >
          <%- eyeOpenIcon %>
          <%- eyeCloseIcon %>
        </label>
        <label>
          Confirm new password:
          <input type="password" name="cpassword" placeholder="Confirm new password" >
          <%- eyeOpenIcon %>
          <%- eyeCloseIcon %>
        </label>
        <button>change password</button>
      </form>
    </div>
  </main-section>
<% } %>