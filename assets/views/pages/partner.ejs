<div class="main-wrapper">
  <% let details = partners %>
  <% if(details){ %>
    <p class="paragraph-wrapper">
      <ul class="ul-wrapper">
        <span class="span-text">Training Partners</span>
        <% for (let detail of details){ %>
          <li class="li-list">
            <details>
              <summary><%= detail.name %></summary>
              <ul>
                <% let location = detail.location %>
                <% if(location){ %>
                  <li><b>Location: </b> <%= detail.location %></li>
                <% } %>

                <% let approvals = detail.approvals %>
                <% if(approvals.length > 0){ %>
                  <li>
                    <b>Programs Approved: </b> 
                    <ul>
                      <% for (let approval of approvals){ %>
                        <li><%= approval.approval %></li>
                      <% } %>
                    </ul>
                  </li>
                <% } %>
                
                <% let phone = detail.phone %>
                <% if(phone){ %>
                  <li><b>Telephone: </b> <%= phone %></li>
                <% } %>

                <% let email = detail.email %>
                <% if(email){ %>
                  <li><b>Email: </b> <%= email %></li>
                <% } %>

                <% let website = detail.website %>
                <% if(website){ %>
                  <li><b>Website: </b> <%= website %></li>
                <% } %>
              </ul>
            </details>
          </li>
        <% }%>
      </ul>
    </p>
  <% } %>
</div>