<% const errorIcon = (new icons('form-error-icon', 'Error')).alert() %>
<% const eyeCloseIcon = (new icons('form-eye-close', 'Hide password')).eyeClose() %>
<% const eyeOpenIcon = (new icons('form-eye-open state-active', 'Show password')).eyeOpen() %>
  <form action="/users/join" method="post" class="signup" autocomplete="off">
    <span class="form-title">
      Sign up
    </span>
    <% if(locals.emailExistsErr){ %>
      <i><%= emailExistsErr %></i>
    <% } %>
    <label>
      <input type="text" class="firstname" name="firstname" minlength="3" required>
      <span class="text-overlay">
        Firstname
      </span>
      <%  if(!locals.emailExistsErr){ if(locals.fnerr){ %>
        <i><%- errorIcon %><%= fnerr %></i>
      <% } }  %>
      </label>
      <label>
        <input type="text" class="surname" name="surname" minlength="3" required>
        <span class="text-overlay">
        Surname
      </span>
      <%  if(!locals.emailExistsErr){ if(locals.snerr){ %>
        <i><%- errorIcon %><%= snerr %></i>
      <% } }  %>
        </label>
        <label>
          <input type="email" class="email" name="email" required>
          
          <span class="text-overlay">
        Email
      </span>
      <%  if(!locals.emailExistsErr){ if(locals.emailerr){ %>
        <i><%- errorIcon %><%= emailerr %></i>
        <% }  } %>
      </label>
          <label>
            <input type="password" class="password" name="password" minlength="8" required>
            <span class="text-overlay">
        Password
      </span>
      <%- eyeOpenIcon %>
      <%- eyeCloseIcon %>
      <%  if(!locals.emailExistsErr){ if(locals.passerr){ %>
        <i><%- errorIcon %><%= passerr %></i>
      <% } }  %>
            </label>
            <label>
              <input type="password" class="confirm-password" name="cpassword" minlength="8" required>
              <span class="text-overlay">
        confirm password
      </span>
      <%- eyeOpenIcon %>
      <%- eyeCloseIcon %>
      <%  if(!locals.emailExistsErr){ if(locals.passerr){ %>
        <i><%- errorIcon %><%= passerr %></i>
      <% } }  %>
              </label>
              <input type="submit" value="Sign up" class="submit">
  </form>