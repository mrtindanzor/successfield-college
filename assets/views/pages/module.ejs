<span class="title">
  <%= locals.module?.title %>
</span>

<div class="module-content">
  <video class="module-video" controls controlsList="nodownload">
    <source src="<%= locals.module?.link %>" type="video/mp4">
  </video>
</div>

<div class="module-nav-bar">
  <a href="/courses/<%= locals.course %>/<%= locals.lastcourse %>" class="module-back btn">back</a>
  <a href="/courses/<%= locals.course %>/<%= locals.nextcourse %>" class="module-next btn">next</a>
</div>