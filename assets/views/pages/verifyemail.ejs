<div class="email-verification-page-container">
  <div class="wrapper">
    <span class="info">
      <% if(locals.verificationDetails.status === 200 ){ %>
        <span class="success"><%= locals.verificationDetails.msg %>, redirecting to login page in <i class="timeout">10</i> secs</span>
      <% } %>

      <% if(verificationDetails.status !== 200 ){ %>
        <div class="failed">
          <%= locals.verificationDetails.msg %>
          <br>
          <input type="text" class="email" placeholder="enter email address">
          <span class="resend-button" href="/users/resend">resend email </span>
        </div>

        <div class="result">
        </div>
      <% } %>
      
    </span>
  </div>
</div>