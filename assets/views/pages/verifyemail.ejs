<% if(locals.verificationDetails.status === 200 ){ %>
  <span class="verified">
    <%= locals.verificationDetails.msg %>, redirecting to login page in <span class="timeout">10</span> secs
  </span>
<% } %>

<% if(verificationDetails.status !== 200 ){ %>
  <form class="resend-form">
    <input type="text" name="email" placeholder="enter email address">
    <button class="resend-button" href="/users/resend">resend email </button>
  </form>
  <div class="result">
    <span class="failed"><%= locals.verificationDetails.msg %></span>
  </div>
<% } %>