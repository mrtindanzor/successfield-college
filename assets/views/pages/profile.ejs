<% const pencil = (new icons('profile-editor-icon', 'Edit profile picture')).pencilFill() %>
<% const profileIcon = (new icons('profile-photo-icon', name)).userLine() %>
<% const closeIcon = (new icons('close-photo-icon', 'Exit')).close() %>
<% const profileImage = user.image.url %>
<div class="profile-wrapper">
  <div class="main-page">
    <div class="profile-image-tab">
      <div class="photo-tab">
        <% if(profileImage){ %>
          <img src="<%= profileImage %>" alt="profile picture" class="profile-img">
          <div class="view-profile-image">
            <%- closeIcon %>
            <img src="<%= profileImage %>" alt="profile picture" class="viewer-profile-img">
          </div>
        <% }else{ %>
          <%- profileIcon %>
        <% } %>
        <label class="photo-chooser">
          <%- pencil %>
          <input type="file" name="image" id="profile-photo-editor">
          <div class="result"></div>
        </label>
      </div>
      <span class="username"><%= name %></span>
    </div>
    <div class="title-bar">
      <div class="back-button"></div>
      <span class="title">title</span>
    </div>
    <ul class="main-links">
      <li>
      <span class="li-heading">Account information</span>
      <ul>
      <li><a href="/users/account-information/username">Name</a></li>
      <li><a href="/users/account-information/phone number">Phone number</a></li>
      <li><a href="/users/account-information/email">Email</a></li>
      <li><a href="/users/account-information/region">Account Region</a></li>
      <li><a href="/users/account-information/change password">Change password</a></li>
      <li><a href="/users/forgotpassword">Reset password</a></li>
      </ul>
      </li>
      <li>
      <span class="li-heading">My Courses</span>
      <ul>
      </ul>
      </li>
      <li>
      <span class="li-heading">My Certificates</span>
      <ul>
      </ul>
      </li>
      <li>
      <span class="li-heading">My Learning Progress</span>
      <ul>
      </ul>
      </li>
      <li>
      <span class="li-heading">Transactions</span>
      <ul>
      <li><a href="">Payment History</a></li>
      </ul>
      </li>
      <li>
      <span class="li-heading">Support</span>
      <ul>
      <li><a href="">Help center</a></li>
      </ul>
      </li>
      <li>
      <span class="li-heading">Login</span>
      <ul>
      <li><a href="/users/members?switch=true">Switch account</a></li>
      <li><a href="/users/logout">Logout</a></li>
      </ul>
      </li>
    </ul>
  </div>
</div>