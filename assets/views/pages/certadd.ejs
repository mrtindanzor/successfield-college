<div class="main-wrapper">
  <form class="cert-add-form">
    <span>
      Add Certificate
    </span>
    <label for="name">
      <b>Name</b>
      <input type="text" name="name" id="name">
    </label>
    <label for="studentNumber">
      <b>Student number</b>
      <input type="text" name="studentNumber" id="studentNumber">
    </label>
    <label for="certificateCode">
      <b>Certificate ID</b>
      <input type="text" name="certificateCode" id="certificateCode">
    </label>
    <label for="programme">
      <b>Programme</b>
      <input type="text" name="programme" id="programme">
    </label>
    <label for="dateCompleted">
      <b>Date of Completion</b>
      <input type="text" name="dateCompleted" id="dateCompleted">
    </label>
    <input type="submit" value="Add">
  </form>
  
  <div class="result">
    
  </div>
</div>