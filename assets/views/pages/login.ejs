<% const eyeCloseIcon = (new locals.icons('form-eye-close', 'Hide password')).eyeClose() %>
<% const eyeOpenIcon = (new locals.icons('form-eye-open state-active', 'Show password')).eyeOpen() %>
<form action="/users/login" method="post" class="signin">
  <span class="form-title">
    Sign in
  </span>
  <i><span class="success">Account created, an email was sent to your address, click link to verify</span></i>
  <label>
    Email
  <input type="email" class="email" name="email" required>
  </label>
  <label>
    Password
    <input type="password" class="password" name="password" minlength="8" required>
    <%- eyeOpenIcon %>
    <%- eyeCloseIcon %>
  </label>
  <input type="submit" value="Sign in" class="submit">
  <div class="other-contrs">
    <a href="/users/forgotpassword" class="forgot-password">Forgot password?</a>
    <p class="account">
      Don't have an account
      <a href="/users/join">Sign up</a>
    </p>
  </div>
</form>