<% const errorIcon = (new icons('form-error-icon', 'Error')).alert() %>
<% const eyeCloseIcon = (new icons('form-eye-close', 'Hide password')).eyeClose() %>
<% const eyeOpenIcon = (new icons('form-eye-open state-active', 'Show password')).eyeOpen() %>
<form action="/users/login" method="post" class="signin">
  <span class="form-title">
    Sign in
  </span>
  <% if(locals.successReg){ %>
    <i class="success"><%= successReg %></i>
  <% } %>
  <% if(locals.failure){ %>
    <i ><%= failure %></i>
  <% } %>
      <label>
        <input type="email" class="email" name="email" required>
        <span class="text-overlay">
      Email
    </span>
    <% if(locals.emailerr){ %>
      <i><%- errorIcon %><%= emailerr %></i>
    <% } %>
    </label>
        <label>
          <input type="password" class="password" name="password" minlength="8" required>
          <span class="text-overlay">
      Password
    </span>
    <%- eyeOpenIcon %>
    <%- eyeCloseIcon %>
      <% if(locals.passerr){ %>
        <i><%- errorIcon %><%= passerr %></i>
      <% } %>
    </label>
            <input type="submit" value="Sign in" class="submit">
</form>