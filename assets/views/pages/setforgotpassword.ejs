<div class="forgot-password-page-container">
  <div class="wrapper">
    <span class="info">

        <form class="email-container">
          <input type="hidden" name="email" value="<%= email %>">
          <input type="password" name="password" placeholder="enter new password">
          <input type="password" name="cpassword" placeholder="confirm new password">
          <button class="send-button">change password</button>
        </form>
        <div class="result">
        </div>   
    </span>
  </div>
</div>