<% const eyeCloseIcon = (new icons('form-eye-close', 'Hide password')).eyeClose() %>
<% const eyeOpenIcon = (new icons('form-eye-open state-active', 'Show password')).eyeOpen() %>
  <div class="forgot-password-page-container">
  <div class="wrapper">
    <span class="info">
    </span>
    <form class="email-container">
      <input type="hidden" name="email" value="<%= email %>">
      <label>
        <input type="password" class="password" name="password" minlength="8" required>
        <span class="text-overlay">
          Enter new password
        </span>
      <%- eyeOpenIcon %>
      <%- eyeCloseIcon %>
      </label>
      <label>
        <input type="password" class="password" name="cpassword" minlength="8" required>
        <span class="text-overlay">
          Confirm new password
        </span>
        <%- eyeOpenIcon %>
        <%- eyeCloseIcon %>
      </label>
      <button class="send-button">change password</button>
    </form>
    <div class="result">
    </div>   
  </div>
</div>